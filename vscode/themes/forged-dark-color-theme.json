  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#758087", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#aabf8a" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": { "foreground": "#c4a67a" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.operator.new", "keyword.operator.expression"],
      "settings": { "foreground": "#d28d70" }
    },
    {
      "scope": ["keyword.control", "keyword.control.flow", "keyword.control.import", "keyword.control.export"],
      "settings": { "foreground": "#d28d70" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"],
      "settings": { "foreground": "#79a9b3" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class"],
      "settings": { "foreground": "#c4a67a" }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable.name"],
      "settings": { "foreground": "#cbd0cd" }
    },
    {
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": { "foreground": "#d7bb8e", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.language", "variable.other.constant"],
      "settings": { "foreground": "#b99bc8" }
    },
    {
      "scope": ["entity.other.attribute-name", "support.type.property-name", "variable.other.property", "meta.object-literal.key"],
      "settings": { "foreground": "#72a7b6" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag", "meta.tag"],
      "settings": { "foreground": "#d28d70" }
    },
    {
      "scope": ["entity.other.attribute-name.html", "entity.other.attribute-name.css"],
      "settings": { "foreground": "#c4a67a" }
    },
    {
      "scope": ["entity.name.selector", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#79a9b3" }
    },
    {
      "scope": ["support.constant.property-value.css", "support.constant.font-name.css", "constant.other.color.rgb-value.css"],
      "settings": { "foreground": "#aabf8a" }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#98a3a8" }
    },
    {
      "scope": ["entity.name.section.markdown", "markup.heading", "markup.heading punctuation.definition.heading"],
      "settings": { "foreground": "#cbd0cd", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold", "markup.bold punctuation.definition.bold"],
      "settings": { "foreground": "#cbd0cd", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic", "markup.italic punctuation.definition.italic"],
      "settings": { "foreground": "#cbd0cd", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link", "markup.inline.raw.string.markdown"],
      "settings": { "foreground": "#c98968" }
    },
    {
      "scope": ["markup.quote", "punctuation.definition.quote.begin.markdown"],
      "settings": { "foreground": "#98a3a8", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#8fbd87" }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#e06c75" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#72a7b6" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ffffff", "background": "#e06c75" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#c4a67a",
    "type": "#c4a67a",
    "class": "#c4a67a",
    "enum": "#c4a67a",
    "interface": "#c4a67a",
    "struct": "#c4a67a",
    "typeParameter": "#d7bb8e",
    "parameter": { "foreground": "#d7bb8e", "italic": true },
    "variable": "#cbd0cd",
    "property": "#72a7b6",
    "enumMember": "#c4a67a",
    "function": "#79a9b3",
    "method": "#79a9b3",
    "macro": "#b99bc8",
    "keyword": "#d28d70",
    "modifier": "#d28d70",
    "comment": { "foreground": "#758087", "italic": true },
    "string": "#aabf8a",
    "number": "#c4a67a",
    "regexp": "#aabf8a",
    "operator": "#98a3a8",
    "decorator": "#b99bc8",
    "variable.readonly": "#c4a67a",
    "property.readonly": "#72a7b6",
    "*.deprecated": { "foreground": "#667075", "strikethrough": true }
  }
}
