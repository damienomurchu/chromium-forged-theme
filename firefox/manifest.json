{
  "manifest_version": 3,
  "name": "Forged Dark",
  "version": "1.0.0",
  "description": "A quiet, copper-accented Firefox theme based on the Forged blog dark palette.",
  "theme": {
    "images": {
      "theme_frame": "assets/forged-header.svg"
    },
    "colors": {
      "frame": "#1b2024",
      "frame_inactive": "#20262a",
      "tab_text": "#cbd0cd",
      "tab_background_text": "#98a3a8",
      "tab_selected": "#272e33",
      "tab_line": "#b97858",
      "tab_loading": "#b97858",
      "toolbar": "#1b2024",
      "toolbar_text": "#cbd0cd",
      "toolbar_field": "#151a1d",
      "toolbar_field_text": "#cbd0cd",
      "toolbar_field_border": "#3a444a",
      "toolbar_field_focus": "#272e33",
      "toolbar_field_text_focus": "#cbd0cd",
      "toolbar_field_border_focus": "#b97858",
      "toolbar_field_highlight": "#b97858",
      "toolbar_field_highlight_text": "#1c1410",
      "toolbar_top_separator": "#3a444a",
      "toolbar_bottom_separator": "#151a1d",
      "toolbar_vertical_separator": "#3a444a",
      "icons": "#98a3a8",
      "icons_attention": "#b97858",
      "button_background_hover": "#30383d",
      "button_background_active": "#3a444a",
      "popup": "#272e33",
      "popup_text": "#cbd0cd",
      "popup_border": "#3a444a",
      "popup_highlight": "#b97858",
      "popup_highlight_text": "#1c1410",
      "ntp_background": "#1b2024",
      "ntp_text": "#cbd0cd",
      "sidebar": "#272e33",
      "sidebar_text": "#cbd0cd",
      "sidebar_border": "#3a444a",
      "sidebar_highlight": "#b97858",
      "sidebar_highlight_text": "#1c1410"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
